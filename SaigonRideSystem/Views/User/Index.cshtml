@using SaigonRideSystem.Models

@{
    ViewData["Title"] = "Manage Users";

    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem
        {
            Title = "Home",
            Url = Url.Action("Home", "Account")
        },
        new BreadcrumbItem
        {
            Title = "Manage Users",
            IsActive = true
        }
    };
}

@{
    ViewData["Title"] = "Manage Users";
}

<h2>Manage Users</h2>

<p class="text-muted">Choose the type of account you want to manage.</p>

<div class="row mt-4">
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h4>Admin Accounts</h4>
                <p class="text-muted">
                    View and manage system administrator accounts.
                </p>

                <a asp-controller="User" asp-action="AdminAccounts" class="btn btn-primary">
                    Manage Admin Accounts
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h4>User Accounts</h4>
                <p class="text-muted">
                    View and manage Local Commuter and Foreign Tourist accounts.
                </p>

                <a asp-controller="User" asp-action="UserAccounts" class="btn btn-success">
                    Manage User Accounts
                </a>
            </div>
        </div>
    </div>
</div>