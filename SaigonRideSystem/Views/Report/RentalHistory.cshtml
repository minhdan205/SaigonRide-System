@model IEnumerable<SaigonRideSystem.Models.Rental>

@using SaigonRideSystem.Models

@{
    ViewData["Title"] = "Rental History";

    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem
        {
            Title = "Home",
            Url = Url.Action("Home", "Account")
        },
        new BreadcrumbItem
        {
            Title = "Manage Reports",
            Url = Url.Action("Index", "Report")
        },
        new BreadcrumbItem
        {
            Title = "Rental History",
            IsActive = true
        }
    };
}

<h2>Rental History</h2>

<table class="table table-bordered table-striped mt-3">
    <thead>
        <tr>
            <th>Rental Code</th>
            <th>User</th>
            <th>Email</th>
            <th>Vehicle</th>
            <th>Category</th>
            <th>Start Station</th>
            <th>Return Station</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Status</th>
            <th>Discount Code</th>
            <th>Total Fare</th>
            <th>Payment</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rental in Model)
        {
            var rentalCode = string.IsNullOrWhiteSpace(rental.RentalCode)
                ? $"Rent.No{rental.RentalId:D3}"
                : rental.RentalCode;

            <tr>
                <td><strong>@rentalCode</strong></td>
                <td>@rental.User?.Name</td>
                <td>@rental.User?.Email</td>
                <td>@rental.VehicleId</td>
                <td>@rental.Vehicle?.Category</td>
                <td>@rental.StartStation?.StationName</td>
                <td>@(rental.ReturnStation?.StationName ?? "-")</td>
                <td>@rental.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(rental.EndTime?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                <td>@rental.Status</td>
                <td>@(string.IsNullOrWhiteSpace(rental.AppliedDiscountCode) ? "-" : rental.AppliedDiscountCode)</td>
                <td>@rental.TotalFare.ToString("N0") VND</td>
                <td>@(rental.Payment?.PaymentStatus.ToString() ?? "Not Paid")</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No rental history available yet.
    </div>
}

<a asp-action="Index" class="btn btn-secondary">Back to Reports</a>