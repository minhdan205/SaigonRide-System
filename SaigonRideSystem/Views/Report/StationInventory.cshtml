@model IEnumerable<SaigonRideSystem.Models.StationInventoryReportItem>

@using SaigonRideSystem.Models

@{
    ViewData["Title"] = "Station Inventory Report";

    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem
        {
            Title = "Home",
            Url = Url.Action("Home", "Account")
        },
        new BreadcrumbItem
        {
            Title = "Manage Reports",
            Url = Url.Action("Index", "Report")
        },
        new BreadcrumbItem
        {
            Title = "Station Inventory Report",
            IsActive = true
        }
    };
}

<h2>Station Inventory Report</h2>

<table class="table table-bordered table-striped mt-3">
    <thead>
        <tr>
            <th>Station Name</th>
            <th>Location</th>
            <th>Capacity</th>
            <th>Current Inventory</th>
            <th>Utilization Rate</th>
            <th>Inventory Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var station in Model)
        {
            <tr>
                <td>@station.StationName</td>
                <td>@station.Location</td>
                <td>@station.Capacity</td>
                <td>@station.CurrentInventory</td>
                <td>@station.UtilizationRate.ToString("N2")%</td>
                <td>
                    @if (station.IsLowInventory)
                    {
                        <span class="badge bg-danger">Low Inventory</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Normal</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Back to Reports</a>