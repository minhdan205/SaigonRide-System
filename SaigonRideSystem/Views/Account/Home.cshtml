@model SaigonRideSystem.Models.User
@using SaigonRideSystem.Models

@{
    ViewData["Title"] = "Home";
    var roleName = Model.UserType == UserType.Admin ? "Admin" : "User";
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2>Welcome, @Model.Name</h2>
            <p class="text-muted">Basic account information</p>

            <hr />

            <dl class="row">
                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Phone Number</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</dd>

                <dt class="col-sm-3">Country</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Country) ? "Not provided" : Model.Country)</dd>

                @if (Model.UserType == UserType.Tourist)
                {
                    <dt class="col-sm-3">Passport Number</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Passport) ? "Not provided" : Model.Passport)</dd>
                }

                <dt class="col-sm-3">Role</dt>
                <dd class="col-sm-9">@roleName</dd>
            </dl>
        </div>
    </div>

    @if (Model.UserType == UserType.Admin)
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <h4>Admin Dashboard</h4>
                <p class="text-muted">Manage stations, vehicles, user accounts, reports, and user support requests.</p>

                <a asp-controller="Station" asp-action="Index" class="btn btn-primary me-2 mb-2">
                    Manage Stations
                </a>

                <a asp-controller="Vehicle" asp-action="Index" class="btn btn-success me-2 mb-2">
                    Manage Vehicles
                </a>

                <a asp-controller="User" asp-action="Index" class="btn btn-warning me-2 mb-2">
                    Manage Users
                </a>

                <a asp-controller="Report" asp-action="Index" class="btn btn-info me-2 mb-2">
                    Manage Reports
                </a>

                <a asp-controller="DiscountCode" asp-action="Index" class="btn btn-secondary me-2 mb-2">
                    Manage Discount Codes
                </a>

                <a asp-controller="Support" asp-action="Index" class="btn btn-dark me-2 mb-2">
                    Support Reports
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h4>SaigonRide User Area</h4>
                <p class="text-muted">Start using SaigonRide rental services or report an issue when you need support.</p>

                <div class="d-grid gap-2 col-md-4 mx-auto">
                    <a asp-controller="Rental" asp-action="AvailableVehicles" class="btn btn-primary">
                        View Available Vehicles
                    </a>

                    <a asp-controller="Rental" asp-action="ActiveRental" class="btn btn-warning">
                        My Active Rental
                    </a>

                    <a asp-controller="Support" asp-action="MyRequests" class="btn btn-dark">
                        Support
                    </a>
                </div>
            </div>
        </div>
    }
</div>