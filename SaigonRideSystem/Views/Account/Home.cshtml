@model SaigonRideSystem.Models.User
@using SaigonRideSystem.Models

@{
    ViewData["Title"] = "Home";
    var roleName = Model.UserType == UserType.Admin ? "Admin" : "User";
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2>Welcome, @Model.Name</h2>
            <p class="text-muted">Basic account information</p>

            <hr />

            <dl class="row">
                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Role</dt>
                <dd class="col-sm-9">@roleName</dd>
            </dl>
        </div>
    </div>

    @if (Model.UserType == UserType.Admin)
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <h4>Admin Dashboard</h4>
                <p class="text-muted">Manage stations, vehicles, and user accounts.</p>

                <a asp-controller="Station" asp-action="Index" class="btn btn-primary me-2">Manage Stations</a>
                <a asp-controller="Vehicle" asp-action="Index" class="btn btn-success me-2">Manage Vehicles</a>
                <a asp-controller="User" asp-action="Index" class="btn btn-warning me-2">Manage Users</a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h4>SaigonRide User Area</h4>
                <p class="text-muted">Start using SaigonRide rental services.</p>

                <div class="d-grid gap-2 col-md-4 mx-auto">
                    <a class="btn btn-primary disabled">View Available Vehicles</a>
                    <a class="btn btn-success disabled">Rent Vehicle</a>
                    <a class="btn btn-warning disabled">Return Vehicle</a>
                    <a class="btn btn-secondary disabled">Make Payment</a>
                </div>
            </div>
        </div>
    }
</div>