@model SaigonRideSystem.Models.Rental

@{
    ViewData["Title"] = "Return Vehicle";
}

<h2>Return Vehicle</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <h4>Rental #@Model.RentalId</h4>

        <p><strong>Vehicle:</strong> @Model.VehicleId</p>
        <p><strong>Category:</strong> @Model.Vehicle?.Category</p>
        <p><strong>Start Station:</strong> @Model.StartStation?.StationName</p>
        <p><strong>Start Time:</strong> @Model.StartTime.ToString("dd/MM/yyyy HH:mm")</p>

        <form asp-action="ReturnConfirmed" method="post">
            <input type="hidden" name="rentalId" value="@Model.RentalId" />

            <div class="mb-3">
                <label class="form-label">Return Station</label>
                <select name="returnStationId" class="form-select" asp-items="ViewBag.ReturnStationId"></select>
            </div>

            <button type="submit" class="btn btn-warning">Confirm Return</button>
            <a asp-action="ActiveRental" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>