@model SaigonRideSystem.Models.Rental
@using SaigonRideSystem.Models

@{
    ViewData["Title"] = "Receipt";

    var rentalCode = string.IsNullOrWhiteSpace(Model.RentalCode)
        ? $"Rent.No{Model.RentalId:D3}"
        : Model.RentalCode;

    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem
        {
            Title = "Home",
            Url = Url.Action("Home", "Account")
        },
        new BreadcrumbItem
        {
            Title = "My Active Rental",
            Url = Url.Action("ActiveRental", "Rental")
        },
        new BreadcrumbItem
        {
            Title = "Return Vehicle"
        },
        new BreadcrumbItem
        {
            Title = "Payment"
        },
        new BreadcrumbItem
        {
            Title = "Rental Receipt",
            IsActive = true
        }
    };
}

<style>
    @@media print {
        header,
        footer,
        .navbar,
        .no-print {
            display: none !important;
        }

        body {
            background: white !important;
        }

        .container {
            max-width: 100% !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .invoice-box {
            padding: 0 !important;
        }
    }

    .invoice-section-title {
        font-weight: 600;
        margin-bottom: 12px;
        border-bottom: 1px solid #dee2e6;
        padding-bottom: 6px;
    }

    .invoice-row {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 8px;
    }

    .invoice-label {
        font-weight: 600;
        color: #495057;
    }

    .invoice-value {
        text-align: right;
        color: #212529;
    }
</style>

<h2 class="no-print">Rental Receipt</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success no-print">@TempData["SuccessMessage"]</div>
}

<div class="card shadow-sm invoice-box">
    <div class="card-body">
        <div class="text-center mb-4">
            <h3>SAIGONRIDE INVOICE</h3>
            <p class="text-muted mb-0">Smart Vehicle Rental System</p>
        </div>

        <hr />

        <div class="row">
            <div class="col-md-6">
                <div class="mb-4">
                    <h5 class="invoice-section-title">Invoice Information</h5>

                    <div class="invoice-row">
                        <span class="invoice-label">Rental Code</span>
                        <span class="invoice-value">@rentalCode</span>
                    </div>

                    <div class="invoice-row">
                        <span class="invoice-label">Invoice Date</span>
                        <span class="invoice-value">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>

                <div class="mb-4">
                    <h5 class="invoice-section-title">Customer Information</h5>

                    <div class="invoice-row">
                        <span class="invoice-label">Customer Name</span>
                        <span class="invoice-value">@Model.User?.Name</span>
                    </div>

                    <div class="invoice-row">
                        <span class="invoice-label">Email</span>
                        <span class="invoice-value">@Model.User?.Email</span>
                    </div>

                    <div class="invoice-row">
                        <span class="invoice-label">Phone Number</span>
                        <span class="invoice-value">
                            @(string.IsNullOrWhiteSpace(Model.User?.PhoneNumber) ? "-" : Model.User.PhoneNumber)
                        </span>
                    </div>
                </div>

                <div class="mb-4">
                    <h5 class="invoice-section-title">Rental Details</h5>

                    <div class="invoice-row">
                        <span class="invoice-label">Vehicle ID</span>
                        <span class="invoice-value">@Model.VehicleId</span>
                    </div>

                    <div class="invoice-row">
                        <span class="invoice-label">Category</span>
                        <span class="invoice-value">@Model.Vehicle?.Category</span>
                    </div>

                    <div class="invoice-row">
                        <span class="invoice-label">Start Station</span>
                        <span class="invoice-value">@Model.StartStation?.StationName</span>
                    </div>

                    <div class="invoice-row">
                        <span class="invoice-label">Return Station</span>
                        <span class="invoice-value">@Model.ReturnStation?.StationName</span>
                    </div>

                    <div class="invoice-row">
                        <span class="invoice-label">Start Time</span>
                        <span class="invoice-value">@Model.StartTime.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    <div class="invoice-row">
                        <span class="invoice-label">End Time</span>
                        <span class="invoice-value">@Model.EndTime?.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-4">
                    <h5 class="invoice-section-title">Fare Summary</h5>

                    <div class="invoice-row">
                        <span class="invoice-label">Station Discount Applied</span>
                        <span class="invoice-value">@(Model.DiscountApplied ? "Yes" : "No")</span>
                    </div>

                    <div class="invoice-row">
                        <span class="invoice-label">Station Discount Amount</span>
                        <span class="invoice-value">@Model.DiscountAmount.ToString("N0") VND</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.AppliedDiscountCode))
                    {
                        <div class="invoice-row">
                            <span class="invoice-label">Discount Code</span>
                            <span class="invoice-value">@Model.AppliedDiscountCode (@Model.CodeDiscountPercent%)</span>
                        </div>

                        <div class="invoice-row">
                            <span class="invoice-label">Code Discount Amount</span>
                            <span class="invoice-value">@Model.CodeDiscountAmount.ToString("N0") VND</span>
                        </div>
                    }

                    <hr />

                    <div class="invoice-row">
                        <span class="invoice-label fs-5">Total Fare</span>
                        <span class="invoice-value fs-5 fw-bold">@Model.TotalFare.ToString("N0") VND</span>
                    </div>
                </div>

                <div class="mb-4">
                    <h5 class="invoice-section-title">Payment Information</h5>

                    <div class="invoice-row">
                        <span class="invoice-label">Payment Method</span>
                        <span class="invoice-value">@Model.Payment?.PaymentMethod</span>
                    </div>

                    <div class="invoice-row">
                        <span class="invoice-label">Payment Status</span>
                        <span class="invoice-value">@Model.Payment?.PaymentStatus</span>
                    </div>

                    <div class="invoice-row">
                        <span class="invoice-label">Payment Date</span>
                        <span class="invoice-value">@Model.Payment?.PaymentDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>

                <div class="alert alert-light border">
                    <p class="mb-0 text-muted">
                        Thank you for using SaigonRide. Please keep this receipt for rental reference and support requests.
                    </p>
                </div>
            </div>
        </div>

        <div class="mt-4 no-print">
            <button onclick="window.print()" class="btn btn-success">
                Print Invoice
            </button>

            <a asp-action="AvailableVehicles" class="btn btn-primary">
                Rent Another Vehicle
            </a>

            <a asp-controller="Account" asp-action="Home" class="btn btn-secondary">
                Back to Home
            </a>
        </div>
    </div>
</div>