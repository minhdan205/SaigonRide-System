@model SaigonRideSystem.Models.Rental
@using SaigonRideSystem.Models

@{
    ViewData["Title"] = "Receipt";

    var rentalCode = string.IsNullOrWhiteSpace(Model.RentalCode)
        ? $"Rent.No{Model.RentalId:D3}"
        : Model.RentalCode;

    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem
        {
            Title = "Home",
            Url = Url.Action("Home", "Account")
        },
        new BreadcrumbItem
        {
            Title = "My Active Rental",
            Url = Url.Action("ActiveRental", "Rental")
        },
        new BreadcrumbItem
        {
            Title = "Return Vehicle",
            Url = Url.Action("Return", "Rental", new { id = Model.RentalId })
        },
        new BreadcrumbItem
        {
            Title = "Payment",
            Url = Url.Action("Payment", "Rental", new { id = Model.RentalId })
        },
        new BreadcrumbItem
        {
            Title = "Rental Receipt",
            IsActive = true
        }
    };
}

<style>
    @@media print {
        header,
        footer,
        .navbar,
        .no-print {
            display: none !important;
        }

        body {
            background: white !important;
        }

        .container {
            max-width: 100% !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .invoice-box {
            padding: 0 !important;
        }
    }
</style>

<h2 class="no-print">Rental Receipt</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success no-print">@TempData["SuccessMessage"]</div>
}

<div class="card shadow-sm invoice-box">
    <div class="card-body">
        <div class="text-center mb-4">
            <h3>SAIGONRIDE INVOICE</h3>
            <p class="text-muted mb-0">Smart Vehicle Rental System</p>
        </div>

        <hr />

        <h5>Invoice Information</h5>

        <p><strong>Rental Code:</strong> @rentalCode</p>
        <p><strong>Invoice Date:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>

        <hr />

        <h5>Customer Information</h5>

        <p><strong>Customer Name:</strong> @Model.User?.Name</p>
        <p><strong>Email:</strong> @Model.User?.Email</p>

        <hr />

        <h5>Rental Details</h5>

        <p><strong>Vehicle:</strong> @Model.VehicleId</p>
        <p><strong>Category:</strong> @Model.Vehicle?.Category</p>
        <p><strong>Start Station:</strong> @Model.StartStation?.StationName</p>
        <p><strong>Return Station:</strong> @Model.ReturnStation?.StationName</p>
        <p><strong>Start Time:</strong> @Model.StartTime.ToString("dd/MM/yyyy HH:mm")</p>
        <p><strong>End Time:</strong> @Model.EndTime?.ToString("dd/MM/yyyy HH:mm")</p>

        <hr />

        <h5>Fare Summary</h5>

        <p><strong>Station Discount Applied:</strong> @(Model.DiscountApplied ? "Yes" : "No")</p>
        <p><strong>Station Discount Amount:</strong> @Model.DiscountAmount.ToString("N0") VND</p>

        @if (!string.IsNullOrWhiteSpace(Model.AppliedDiscountCode))
        {
            <p><strong>Discount Code:</strong> @Model.AppliedDiscountCode (@Model.CodeDiscountPercent%)</p>
            <p><strong>Code Discount Amount:</strong> @Model.CodeDiscountAmount.ToString("N0") VND</p>
        }

        <h4 class="mt-3"><strong>Total Fare:</strong> @Model.TotalFare.ToString("N0") VND</h4>

        <hr />

        <h5>Payment Information</h5>

        <p><strong>Payment Method:</strong> @Model.Payment?.PaymentMethod</p>
        <p><strong>Payment Status:</strong> @Model.Payment?.PaymentStatus</p>
        <p><strong>Payment Date:</strong> @Model.Payment?.PaymentDate.ToString("dd/MM/yyyy HH:mm")</p>

        <hr />

        <p class="text-center text-muted">
            Thank you for using SaigonRide.
        </p>

        <div class="mt-4 no-print">
            <button onclick="window.print()" class="btn btn-success">
                Print Invoice
            </button>

            <a asp-action="AvailableVehicles" class="btn btn-primary">
                Rent Another Vehicle
            </a>

            <a asp-controller="Account" asp-action="Home" class="btn btn-secondary">
                Back to Home
            </a>
        </div>
    </div>
</div>