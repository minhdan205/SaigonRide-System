@model SaigonRideSystem.Models.Station

@{
    ViewData["Title"] = "Station Details";
}

<h2>Station Details</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Station Name</dt>
            <dd class="col-sm-9">@Model.StationName</dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Model.Location</dd>

            <dt class="col-sm-3">Capacity</dt>
            <dd class="col-sm-9">@Model.Capacity</dd>

            <dt class="col-sm-3">Current Inventory</dt>
            <dd class="col-sm-9">@Model.CurrentInventory</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Vehicle Count</dt>
            <dd class="col-sm-9">@Model.Vehicles.Count</dd>
        </dl>

        <a asp-action="Edit" asp-route-id="@Model.StationId" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>