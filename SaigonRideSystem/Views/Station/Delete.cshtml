@model SaigonRideSystem.Models.Station

@{
    ViewData["Title"] = "Delete Station";
}

<h2>Delete Station</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this station?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Station Name</dt>
            <dd class="col-sm-9">@Model.StationName</dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Model.Location</dd>

            <dt class="col-sm-3">Capacity</dt>
            <dd class="col-sm-9">@Model.Capacity</dd>

            <dt class="col-sm-3">Current Inventory</dt>
            <dd class="col-sm-9">@Model.CurrentInventory</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="StationId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>