@model SaigonRideSystem.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<h2>Delete Vehicle</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this vehicle?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Vehicle ID</dt>
            <dd class="col-sm-9">@Model.VehicleId</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Assigned Station</dt>
            <dd class="col-sm-9">@Model.Station?.StationName</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="VehicleId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>